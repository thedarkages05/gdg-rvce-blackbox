#!/usr/bin/exec-suid -- /usr/bin/python3 -I
import http.server, urllib.parse, os
BASE = "/challenge/pages"
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.urlparse(self.path).query
        page = urllib.parse.parse_qs(q).get("page", ["home.txt"])[0]
        page = page.replace("../", "")
        path = os.path.join(BASE, page)
        try:
            data = open(path, "rb").read()[:8000]
            self.send_response(200); self.send_header("Content-Length", str(len(data))); self.end_headers(); self.wfile.write(data)
        except Exception:
            body = b"Not found. Hint: ?page=....//....//....//....//flag\n"
            self.send_response(404); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, *a):
        pass
if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", 80), H).serve_forever()
