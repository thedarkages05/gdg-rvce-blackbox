#!/usr/bin/exec-suid -- /usr/bin/python3 -I
import http.server, hmac, hashlib, base64, json
SECRET = b"canteen123"
FLAG = open("/flag").read().strip()
def b64d(s): return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))
def b64e(b): return base64.urlsafe_b64encode(b).decode().rstrip("=")
def verify(tok):
    try:
        h, p, s = tok.split(".")
        sig = b64e(hmac.new(SECRET, (h + "." + p).encode(), hashlib.sha256).digest())
        if not hmac.compare_digest(sig, s):
            return None
        return json.loads(b64d(p))
    except Exception:
        return None
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        cookie = self.headers.get("Cookie", "")
        tok = ""
        for c in cookie.split(";"):
            if "token=" in c:
                tok = c.split("token=")[-1].strip()
        if self.path.startswith("/admin"):
            claims = verify(tok)
            if claims and claims.get("role") == "admin":
                body = ("FLAG: " + FLAG + "\n").encode()
                self.send_response(200); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body); return
            body = b"Only admin. Hint: crack SECRET from wordlist.txt and forge role=admin. See app.py.\n"
            self.send_response(403); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body); return
        hdr = b64e(json.dumps({"alg": "HS256", "typ": "JWT"}).encode())
        pay = b64e(json.dumps({"user": "guest", "role": "user"}).encode())
        sig = b64e(hmac.new(SECRET, (hdr + "." + pay).encode(), hashlib.sha256).digest())
        body = b"Welcome to Canteen. Try /admin. Source: /challenge/app.py\n"
        self.send_response(200); self.send_header("Set-Cookie", "token=" + hdr + "." + pay + "." + sig); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, *a):
        pass
if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", 80), H).serve_forever()
