#!/usr/bin/exec-suid -- /usr/bin/python3 -I
import http.server, urllib.parse, os
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.urlparse(self.path).query
        name = urllib.parse.parse_qs(q).get("name", ["guest"])[0][:500]
        out = "Hello " + name
        if "{{" in name and "}}" in name:
            try:
                inner = name.split("{{", 1)[1].rsplit("}}", 1)[0]
                val = str(eval(inner, {"__builtins__": {}, "os": os}))
                out = "Hello " + val
            except Exception as e:
                out = "Template error: " + str(e)[:200]
        body = (out + "\n").encode()
        self.send_response(200); self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self, *a):
        pass
if __name__ == "__main__":
    http.server.HTTPServer(("127.0.0.1", 80), H).serve_forever()
